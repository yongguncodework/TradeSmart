# OpenAI (required for agent + embeddings)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Demo UI (optional — defaults to local API)
TRADESMART_API_URL=http://127.0.0.1:8000

# RAG
CHROMA_PERSIST_DIR=./data/chroma
PLAYBOOKS_DIR=./data/playbooks
JOURNAL_PATH=./data/journal/trades.jsonl
RAG_TOP_K=4

# Risk defaults (override via API if needed)
MAX_POSITION_PCT=15.0
MAX_LEVERAGED_ETF_PCT=8.0
MAX_DAILY_LOSS_PCT=3.0
